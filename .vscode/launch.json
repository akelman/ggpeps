            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Tests",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/test.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Eval MC L=2",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/manager.py",
            "console": "integratedTerminal",
            "args": [
                "eval-mc",
                "2",
                "--level", "debug",
                "--warmup_steps", "1000",
                "--meas_steps", "1000",
                "--seed", "15", 
                "--ncopy", "2",
                "--nlayer", "2", 
                "--g_el", "0",
                "--g_mag", "0", 
                "--g_int", "1",
                "--g_mass", "0",
                "--ignore_cache"
            ]
        },
