    "version": "0.2.0",
    "configurations": [

        {
            "name": "Python: Current File",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Tests",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/test.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Eval L=2",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/manager.py",
            "args": ["eval","2","--level","debug", "--warmup", "1000"],
            "console": "integratedTerminal"
        }
    ]
}