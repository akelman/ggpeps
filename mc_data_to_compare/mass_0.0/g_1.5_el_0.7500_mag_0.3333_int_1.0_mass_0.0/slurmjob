#!/bin/bash -l

# Standard output and error:
#SBATCH -o ./tjob.out.%j
#SBATCH -e ./tjob.err.%j

# Initial working directory:
#SBATCH -D ./

# Job Name:
#SBATCH -J rL4g_1.5_int_1.0_mass_0.0

# Queue (Partition):
#SBATCH -A alex-account
#SBATCH --partition=alexq
# Number of nodes and MPI tasks per node:
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
# Number of cpus
#SBATCH --cpus-per-task=8
#SBATCH -c 8
#SBATCH --mem-per-cpu=1GB

#SBATCH --nodelist=landau52

#SBATCH --mail-type=FAIL
#SBATCH --mail-user=ariel.kelman@mail.huji.ac.il
#
# Wall clock limit:
#SBATCH --time=0

#Load some modules
module purge
source ~/.pyenv/ggpeps/bin/activate

PROJECTS=/usr/people/snirgaz/arielkelman/projects/gaussian-peps

# Run the program: 
srun python $PROJECTS/manager.py min-mc 4 --fermions --ncopy 2 --num_pg_layer 1 --num_fermionic_layer 1 --params paramvec.npy --warmup_steps 50000 --meas_steps 120000 --update_size 8 --nrunner 8 --g 1.5 --int 1.0 --mass 0.0

if [ -d /tmp/ray ]
then
	rm -rf /tmp/ray
fi

