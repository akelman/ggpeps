    if result is not None:
        return "--chempot {}".format(float(result.group(0)))
    else:
        return ""

def format_slurmfile(slurmfile, name, folder, time=time_default,command=command_default, num_threads=num_threads_default):
    coupling = folder2coupling(folder)
    mass = folder2mass(folder)
    int = folder2int(folder)
    el = folder2el(folder)
    mag = folder2mag(folder)
    chempot = folder2chempot(folder)
    return slurmfile.format(jobname=name,time=time,command=command,ncpu=num_threads, coupling=coupling, mass=mass, chempot=chempot, el=el, mag=mag, int=int)

def main(args):
    if os.path.isfile(args.slurmfile):
        with open(args.slurmfile,mode='r') as infile:
            slurmfile_str= infile.read()
        command=args.command if args.command is not None else command_default
        time=args.time if args.time is not None else time_default
        num_threads=args.num_threads if args.num_threads is not None else num_threads_default
        for folder in args.folders:
            if os.path.isdir(folder):
                with open(os.path.join(folder,"slurmjob"),'w') as f:
                    name=name_from_path(args.prefix,folder)
                    slurmfile_format=format_slurmfile(slurmfile_str,name, folder, time, command, num_threads)
                    print(slurmfile_format,file=f)
            else:
                print("Folder '{}' does not exist".format(folder))

    else:
        print("Master slurmfile not found at '{}'".format(args.slurmfile))


if __name__=="__main__":
    import argparse
    parser = argparse.ArgumentParser()
    parser.add_argument("-f","--folders",dest="folders",type=str,nargs="+",help="List of folders to modify",default=None)
    parser.add_argument("-i","--slurmfile",dest="slurmfile",type=str,help="Master slurm file",default=None)
    parser.add_argument("-t","--time",dest="time",type=str,help="time attribute (default: 24:00:00)",default=None)
    parser.add_argument("-c","--command",dest="command",type=str,help="command",default=None)
    parser.add_argument("-n","--num_threads",dest="num_threads",type=str,help="number of OMP threads (default: 4)",default=None)
    parser.add_argument("--prefix",type=str,help="name prefix (default: empty string)",default="")
    args=parser.parse_args()
    main(args)

