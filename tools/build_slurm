#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import numpy as np
import sys
import os

command_default=""
time_default="24:00:00"
num_threads_default="4"

def name_from_path(prefix,path):
    return prefix+path

def folder2coupling(foldername):
    import re
    pattern=r"(?<=g_)[\d]*.[\d]*"
    result = re.search(pattern, foldername)
    if result is not None:
        return "--g {}".format(float(result.group(0)))
    else:
        return ""

